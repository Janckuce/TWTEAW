# Default: normalize all text files to LF
   * text=auto eol=lf

   # Paradox script files
   *.txt text eol=lf
   *.yml text eol=lf
   *.mod text eol=lf
   *.lua text eol=lf
   *.gui text eol=lf
   *.gfx text eol=lf
   *.sfx text eol=lf
   *.asset text eol=lf

   # Documentation
   *.md text eol=lf
   
   # Binary files - never convert
   *.png binary
   *.jpg binary
   *.dds binary
   *.tga binary
   *.ogg binary
   *.wav binary
   *.mp3 binary
   *.dae binary
   *.mesh binary
   *.anim binary